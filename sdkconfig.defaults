# ESP32-WROOM-32 on a DevKitC. Bluetooth Classic only; this device never joins a network.

CONFIG_IDF_TARGET="esp32"

# --- Bluetooth ----------------------------------------------------------------
# BR/EDR only. BLE is not used, and turning it off here also hands its controller
# memory back to the heap at startup.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# The internal decoder path, which is where the codec framework lives. The
# external-codec path hands over undecoded frames but registers SBC-only
# endpoints in stock IDF, so it still buys nothing.
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=n

# Codecs beyond SBC. These options do not exist in stock IDF; they arrive with
# patches/0001 and the sources in bt_overlay/. See docs/BASE.md.
# LDAC is deliberately absent: the only decoder in circulation ships with no
# licence at all, and Sony publishes an encoder only.
CONFIG_BT_A2DP_APTX_DECODER=y
CONFIG_BT_A2DP_AAC_DECODER=y
CONFIG_BT_A2DP_LHDCV5_DECODER=y

# Not used: no serial port profile, no BLE host.
CONFIG_BT_SPP_ENABLED=n

# --- Flash and partitions -----------------------------------------------------
# Bluedroid with Classic BT does not fit the 1 MB default factory partition.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Console ------------------------------------------------------------------
# UART0 on GPIO1/3, which is the CH9102 bridge on the DevKitC. The link to the
# host is UART2 on GPIO17/16 and has nothing to do with this.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- CPU --------------------------------------------------------------------
# 240 MHz, not the 160 MHz default. The aptX decoder is a fixed-point DSP loop
# and it is the single hottest thing in this firmware: with the console storm
# throttled, the task watchdog showed A2DP_DECODER holding CPU 1 at 100% while
# CPU 0 sat idle. A single task cannot be spread across cores, so the only
# lever is to make its core faster.
#
# Costs about 20-30 mA more. DEVICE_SPEC.md budgets a 0.5 A regulator against
# transmit peaks near 130 mA, so there is room.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# -O2 rather than the -Og the project had been building with all along. Debug
# optimisation on a codec inner loop is the difference between decoding in real
# time and not.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
