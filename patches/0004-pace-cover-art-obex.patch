+/* Satellite policy: pull one small OBEX packet at a time. BTA alarms dispatch
+ * on BTU, so no Bluetooth callback/task sleeps while A2DP is running. */
+static TIMER_LIST_ENT cover_continue_timer[BTA_AV_NUM_RCB];
+static BOOLEAN cover_continue_pending[BTA_AV_NUM_RCB];
+static UINT16 cover_continue_handle[BTA_AV_NUM_RCB];
+
+static void cover_cancel_continue(tBTA_AV_RCB *p_rcb)
+{
+    UINT8 idx = get_rcb_idx(p_rcb);
+    cover_continue_pending[idx] = FALSE;
+    bta_sys_stop_timer(&cover_continue_timer[idx]);
+}
+
+static void cover_continue_cb(void *arg)
+{
+    TIMER_LIST_ENT *timer = (TIMER_LIST_ENT *)arg;
+    UINT32 idx = (UINT32)timer->param;
+    if (idx >= BTA_AV_NUM_RCB || !cover_continue_pending[idx]) return;
+    cover_continue_pending[idx] = FALSE;
+    tBTA_AV_RCB *p_rcb = &bta_av_cb.rcb[idx];
+    if (p_rcb->handle != BTA_AV_RC_HANDLE_NONE && p_rcb->cover_art_goep_hdl &&
+        p_rcb->cover_art_goep_hdl == cover_continue_handle[idx])
+        build_and_send_empty_get_req(p_rcb);
+}
+
+static void cover_schedule_continue(tBTA_AV_RCB *p_rcb)
+{
+    UINT8 idx = get_rcb_idx(p_rcb);
+    TIMER_LIST_ENT *timer = &cover_continue_timer[idx];
+    timer->p_cback = cover_continue_cb;
+    timer->param = idx;
+    cover_continue_handle[idx] = p_rcb->cover_art_goep_hdl;
+    cover_continue_pending[idx] = TRUE;
+    bta_sys_start_timer(timer, 0, 50);
+}
+
 static void close_goepc_and_disconnect(tBTA_AV_RCB *p_rcb)
 {
+    cover_cancel_continue(p_rcb);
     if (p_rcb->cover_art_goep_hdl) {
         GOEPC_Close(p_rcb->cover_art_goep_hdl);
     }
