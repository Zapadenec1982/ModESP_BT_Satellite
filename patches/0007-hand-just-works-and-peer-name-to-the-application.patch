     memcpy(param.cfm_req.bda, p_cfm_req->bd_addr, ESP_BD_ADDR_LEN);
+    /* BTA reads the peer's name before it passes the request up, when it can. */
+    memcpy(param.cfm_req.device_name, p_cfm_req->bd_name, ESP_BT_GAP_MAX_BDNAME_LEN);
+    param.cfm_req.device_name[ESP_BT_GAP_MAX_BDNAME_LEN] = '\0';
