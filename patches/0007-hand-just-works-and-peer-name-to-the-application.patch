-
+    /* Just Works goes to the application as well, flagged, rather than being
+     * answered yes here. An application that puts pairing in front of a person
+     * has to see every request: answered here, a peer that claims to have no
+     * display would pair past that person without being asked. The application
+     * replies to both kinds with esp_bt_gap_ssp_confirm_reply(). */
     esp_bt_gap_cb_param_t param;
     bt_status_t ret;
     btc_msg_t *msg;
@@ -518,8 +517,13 @@
     msg->sig = BTC_SIG_API_CB;
