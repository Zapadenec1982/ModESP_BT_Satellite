+  if (allow) {
+    a2dp_sbc_sink_caps.samp_freq |= A2D_SBC_IE_SAMP_FREQ_48;
+  } else {
+    a2dp_sbc_sink_caps.samp_freq &= ~A2D_SBC_IE_SAMP_FREQ_48;
+  }
