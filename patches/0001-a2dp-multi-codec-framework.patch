+# --- Optional A2DP decoders ---------------------------------------------------
+#
+# Each codec is a Kconfig option and a set of sources; nothing else in the build
+# changes when one is turned on or off. See docs/BASE.md.
+
+if(CONFIG_BT_A2DP_APTX_DECODER)
+    # libfreeaptx is LGPL-2.1-or-later; the wrapper around it is Apache-2.0.
+    list(APPEND bluedroid_host_priv_include_dirs
+        "${CMAKE_CURRENT_LIST_DIR}/external/libfreeaptx/main")
+    list(APPEND bluedroid_host_srcs
+        "${CMAKE_CURRENT_LIST_DIR}/external/libfreeaptx/main/freeaptx.c"
+        "${CMAKE_CURRENT_LIST_DIR}/stack/a2dp/a2dp_vendor_aptx.c"
