-/*
- * Throttle for the warnings on the media path.
- *
- * Both of the sites below report a per-packet event, and at 48 kHz aptX HD that
- * is around 120 packets a second. Printing one line each is not a diagnostic, it
- * is the fault: measured on this board, 114 lines a second at 115200 baud came to
- * roughly 0.8 seconds of blocking console writes per second, on the same task
- * that decodes the audio and drains this queue. The queue then overflows, which
- * drops packets, which breaks the codec frame sync, which logs more -- and the
- * storm sustains itself long after whatever started it has gone.
- *
- * So: count everything, print at most one line every couple of seconds, and put
- * the count in the line so that nothing is actually lost.
- */
-#define BTC_A2DP_SINK_WARN_PERIOD_MS   2000
-
-static BOOLEAN btc_a2dp_sink_warn_due(UINT32 *p_next_tick)
-{
-    UINT32 now = (UINT32)xTaskGetTickCount();
-    if (*p_next_tick != 0 && (INT32)(now - *p_next_tick) < 0) {
-        return FALSE;
-    }
-    *p_next_tick = now + pdMS_TO_TICKS(BTC_A2DP_SINK_WARN_PERIOD_MS);
-    return TRUE;
-}
